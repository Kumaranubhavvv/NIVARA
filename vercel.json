{
  "buildCommand": "cd frontend && npm install && npx expo export -p web",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/_expo/(.*)",
      "dest": "/_expo/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
